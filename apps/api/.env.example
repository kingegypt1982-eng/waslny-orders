NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://waslny_orders_user:CHANGE_ME_STRONG_PASSWORD@localhost:5435/waslny_orders_dev?schema=public"
# Direct (non-pooler) connection used by `prisma migrate deploy`. On pooled
# providers (e.g. Supabase) set this to the direct session connection.
DIRECT_URL="postgresql://waslny_orders_user:CHANGE_ME_STRONG_PASSWORD@localhost:5435/waslny_orders_dev?schema=public"
REDIS_URL="redis://127.0.0.1:6380"
JWT_SECRET=CHANGE_ME_RANDOM_32_PLUS_CHARS
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (takes precedence over CLIENT_ORIGIN).
# Optional: when both this and CLIENT_ORIGIN are empty the app still boots, but
# no CORS headers are emitted. Set it in production for browser clients.
CORS_ORIGINS=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
# Seed admin account (used by `npm run prisma:seed`, which `prisma migrate dev`
# also runs). ADMIN_PASSWORD is required in every environment — including
# development — and has no default. Replace the placeholder with a unique value.
ADMIN_EMAIL=admin@waslny.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Local/Test Kashier placeholders. Never mix Test hosts with Live keys.
KASHIER_MERCHANT_ID=MID-XXXXX-XXX
KASHIER_API_KEY=your-test-payment-api-key
KASHIER_SECRET_KEY=your-test-secret-key
KASHIER_BASE_URL=https://test-api.kashier.io
# Optional only for accounts that use Kashier multi-merchant authorization.
KASHIER_AUTH_MERCHANT_ID=

# Production/Live Railway placeholders (set these as Railway Variables):
# KASHIER_MERCHANT_ID=MID-LIVE-XXXXX-XXX
# KASHIER_API_KEY=your-live-payment-api-key
# KASHIER_SECRET_KEY=your-live-secret-key
# KASHIER_BASE_URL=https://api.kashier.io
# KASHIER_WEBHOOK_URL=https://waslny-orders-production.up.railway.app/api/v1/webhooks/kashier
# KASHIER_REDIRECT_URL=https://waslny-orders-production.up.railway.app/api/v1/payment-return
# KASHIER_AUTH_MERCHANT_ID=
# KASHIER_ALLOW_TEST_IN_PRODUCTION=false
# Kashier webhook: public POST endpoint served under the global /api/v1 prefix.
# Railway example: https://<PUBLIC_RAILWAY_DOMAIN>/api/v1/webhooks/kashier
# Production requires this value; do not use a localhost URL in Railway.
KASHIER_WEBHOOK_URL=
# Browser return URL after checkout. Production must use https:// and may use
# the API-owned public page: https://<PUBLIC_RAILWAY_DOMAIN>/api/v1/payment-return
# Local development remains HTTP and points to the local app or API route.
KASHIER_REDIRECT_URL=http://localhost:5173/payment-redirect
# Google sign-in: OAuth 2.0 Web client ID used as the ID-token audience.
# Required at boot when /auth/google is used; requests fail clearly if empty.
GOOGLE_CLIENT_ID=
# AES-256-GCM key for captain national IDs. Base64-encoded 32 bytes (256-bit).
# Required at boot: the API refuses to start without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional NATIONAL_ID_HASH_KEY (also base64 32 bytes) may be set to keep the
# HMAC key separate from the encryption key; otherwise it falls back to this one.
NATIONAL_ID_ENCRYPTION_KEY=

# Firebase configuration (optional - enables secure chat feature)
# Set to a valid path when ready to deploy chat feature. Chat is disabled by default.
# FIREBASE_SERVICE_ACCOUNT_PATH=
#   Full path to the Firebase service account JSON file (e.g., /path/to/serviceAccount.json)
# FIREBASE_DATABASE_URL=
#   Firebase Realtime Database URL (e.g., https://waslny-c6ffb-default-rtdb.europe-west1.firebasedatabase.app)
# CHAT_ENABLED=
#   Set to true to enable the chat feature (default: false)
# CHAT_CLEANUP_DAYS=
#   Age in days for closed-chat cleanup (default: 7)